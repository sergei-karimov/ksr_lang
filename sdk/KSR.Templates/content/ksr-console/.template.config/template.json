{
  "$schema": "http://json.schemastore.org/template",
  "author": "Kestrel Authors",
  "classifications": [ "Kestrel", "Console" ],
  "identity": "Kestrel.Console",
  "name": "Kestrel Console Application",
  "shortName": [ "kestrel-console", "ksr-console" ],
  "description": "A Kestrel language console application.",
  "tags": {
    "language": "Kestrel",
    "type": "project"
  },
  "sourceName": "MyApp",
  "preferNameDirectory": true,
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework for the project.",
      "datatype": "choice",
      "choices": [
        { "choice": "net10.0", "description": ".NET 10" }
      ],
      "defaultValue": "net10.0",
      "replaces": "net10.0"
    }
  }
}
