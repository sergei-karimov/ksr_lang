{
  "$schema": "http://json.schemastore.org/template",
  "author": "Kestrel Authors",
  "classifications": [ "Kestrel", "Creative", "Camera", "OpenCV" ],
  "identity": "Kestrel.CreativeCameraApp",
  "name": "Kestrel Creative Camera Application",
  "shortName": [ "kestrel-creative-camera", "ksr-creative-camera" ],
  "description": "A Kestrel creative-coding camera app with webcam capture and frame processing.",
  "tags": {
    "language": "Kestrel",
    "type": "project"
  },
  "sourceName": "MyCameraApp",
  "preferNameDirectory": true,
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework for the project.",
      "datatype": "choice",
      "choices": [
        { "choice": "net10.0", "description": ".NET 10" }
      ],
      "defaultValue": "net10.0",
      "replaces": "net10.0"
    }
  }
}
