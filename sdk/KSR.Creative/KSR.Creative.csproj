<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);8981</NoWarn>

    <PackageId>Kestrel.Creative</PackageId>
    <Version>0.1.0</Version>
    <Authors>Kestrel Authors</Authors>
    <Description>Kestrel creative-coding runtime: minimal Raylib window, draw loop, and FPS display.</Description>
    <PackageTags>kestrel;ksr;creative-coding;raylib;graphics</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="7.0.2" />
  </ItemGroup>

</Project>
